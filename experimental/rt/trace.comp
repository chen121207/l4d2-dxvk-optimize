#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT world;
struct Triangle { vec3 a; uint id; vec3 b; uint pad0; vec3 c; uint pad1; vec3 albedo; uint pad2; };
layout(set=0,binding=1,std430) readonly buffer Mesh { Triangle triangles[]; };
layout(set=0,binding=2,rgba32f) uniform writeonly image2D colorImage;
layout(set=0,binding=3,r32f) uniform writeonly image2D depthImage;
layout(set=0,binding=4,rg32f) uniform writeonly image2D motionImage;
layout(set=0,binding=5,r32ui) uniform writeonly uimage2D idImage;
struct Camera { vec3 origin; float fov; vec3 forward; float aspect;
                vec3 right; uint flags; vec3 up; float farPlane; };
layout(push_constant) uniform Params { Camera current; Camera other; } pc;
const vec3 sky=vec3(.13,.19,.28);
const vec3 light=normalize(vec3(-.7,-.3,.4));
bool hit(vec3 origin, vec3 direction, float limit, bool shadow, out uint primitive, out float t) {
  rayQueryEXT q;
  uint flags=gl_RayFlagsOpaqueEXT;
  if(shadow) flags |= gl_RayFlagsTerminateOnFirstHitEXT;
  rayQueryInitializeEXT(q,world,flags,255,origin,.01,direction,limit);
  while(rayQueryProceedEXT(q)) {}
  if(rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionTriangleEXT) return false;
  primitive=rayQueryGetIntersectionPrimitiveIndexEXT(q,true);
  t=rayQueryGetIntersectionTEXT(q,true);
  return true;
}
vec3 normalAt(Triangle tri,vec3 ray) {
  vec3 n=normalize(cross(tri.b-tri.a,tri.c-tri.a));
  return dot(n,ray)>0 ? -n : n;
}
vec3 shade(Triangle tri,vec3 p,vec3 n,vec3 direction,bool shadows) {
  float visibility=1;
  uint blocker=0;float distance=0;
  if(shadows && dot(n,light)>0 && hit(p+n*.02,light,pc.current.farPlane,true,blocker,distance)) visibility=0;
  return tri.albedo*(.08+.35*max(0,dot(n,-direction))+.9*visibility*max(0,dot(n,light)));
}
void main() {
  ivec2 pixel=ivec2(gl_GlobalInvocationID.xy), size=imageSize(colorImage);
  if(any(greaterThanEqual(pixel,size))) return;
  vec2 uv=(vec2(pixel)+.5)/vec2(size)*2-1;
  vec3 ray=normalize(pc.current.forward+pc.current.right*uv.x*pc.current.aspect*pc.current.fov
                     -pc.current.up*uv.y*pc.current.fov);
  vec3 color=sky;float depth=pc.current.farPlane;uint id=0;vec2 motion=vec2(0);
  uint primitive=0;float t=0;
  if((pc.current.flags&1)!=0 && hit(pc.current.origin,ray,pc.current.farPlane,false,primitive,t)) {
    Triangle tri=triangles[primitive];vec3 p=pc.current.origin+ray*t;
    vec3 n=normalAt(tri,ray);
    color=shade(tri,p,n,ray,(pc.current.flags&2)!=0);
    if((pc.current.flags&4)!=0) {
      vec3 reflected=reflect(ray,n);uint ri=0;float rt=0;vec3 rc=sky;
      if(hit(p+n*.02,reflected,pc.current.farPlane,false,ri,rt)) {
        Triangle rtri=triangles[ri];
        rc=shade(rtri,p+n*.02+reflected*rt,normalAt(rtri,reflected),reflected,(pc.current.flags&2)!=0);
      }
      // Diagnostic fixed reflectance, NOT Source material recovery.
      color=mix(color,rc,.25);
    }
    depth=dot(p-pc.current.origin,pc.current.forward);id=tri.id;
    vec3 delta=p-pc.other.origin;float z=dot(delta,pc.other.forward);
    if(z>.01) {
      vec2 otherUv=vec2(dot(delta,pc.other.right)/(z*pc.other.fov*pc.other.aspect),
                       -dot(delta,pc.other.up)/(z*pc.other.fov));
      motion=(otherUv*.5+.5)*vec2(size)-.5-vec2(pixel);
    } else motion=vec2(1e8); // Invalid reprojection; consumer rejects, never a fabricated zero MV.
  }
  imageStore(colorImage,pixel,vec4(color,1));
  imageStore(depthImage,pixel,vec4(depth));
  imageStore(motionImage,pixel,vec4(motion,0,0));
  imageStore(idImage,pixel,uvec4(id));
}
